### Get expenses
GET http://localhost:8080/expenses
Authorization: Bearer {{auth_token_alex}}

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

%}
### Create expense
POST http://localhost:8080/expenses
Authorization: Bearer {{auth_token_alex}}
Content-Type: application/json

{
  "title": "dinner with swat",
  "targetAmount": 200.00
}

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.global.set("expenseId", jsonPath(response.body, "$.id"))

 %}
### Claim share
PUT http://localhost:8080/expenses/{{expenseId}}/shares
Authorization: Bearer {{auth_token_alex}}
Content-Type: application/json

{
  "targetAmount": 100.00
}

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });

 %}
