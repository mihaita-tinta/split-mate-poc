### List shares
GET http://localhost:8080/expenses/{{expenseId}}/shares
Authorization: Bearer {{auth_token_alex}}
Content-Type: application/json

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.global.set("shareId", jsonPath(response.body, "$.shares[0].id"))

%}

### List payments for share
GET http://localhost:8080/payments?internalReferenceId={{shareId}}
Authorization: Bearer {{auth_token_john}}
Content-Type: application/json

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.global.set("paymentId", jsonPath(response.body, "$.payments[0].id"))

%}
### Initiate payment for share. Use GB33BUKB20201555555555
POST http://localhost:8080/payments/{{paymentId}}
Authorization: Bearer {{auth_token_john}}
Content-Type: application/json

{
  "email": "test@example.com"
}
> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
    var url = jsonPath(response.body, "$.url");
    const searchParams = new URLSearchParams(url);

    client.global.set("paymentReferenceId", searchParams.get('https://stage.checkout.noda.live/buffet?id'));

%}

